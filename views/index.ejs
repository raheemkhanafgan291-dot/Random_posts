<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="style.css" rel="stylesheet">
</head>
<body>
    <h1>Random Posts</h1>
    <% for(let post of posts){%>
      <div class="post">
        <h3 class="username">@ <%= post.username %> </h3>
        <h3 class="content">@ <%= post.content %> </h3>
        <br>
        <div class="actions">
        <a href="http://localhost:3000/posts/<%= post.id %>">See in details</a>
        <a href="http://localhost:3000/posts/<%= post.id %>/edit">Edit your post</a>
        <form method="post" action="/posts/<%= post.id %>?_method=DELETE"">
           <button>Delete</button>
        </form>
      </div>
      </div>
    <% }%>
    <a id="anchorTag" href="http://localhost:3000/posts/new">Create Post</a>
</body>
</html>