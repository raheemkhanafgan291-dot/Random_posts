<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="style.css" rel="stylesheet">
</head>
<body>
    <h1>Random Posts</h1>


    
    <% for(let post of posts){%>
      <div class="post">
        <h3 class="username">@ <%= post.username %> </h3>
        <h3 class="content">@ <%= post.content %> </h3>
        </div>
      <form method="POST" action="/posts/ <% post.id %> /like">
        <button type="submit">&#129655; <%= post.likes %></button>
      </form>
      </div>
        <br>
        <div class="actions">
          <img class="photo" src="https://www.shutterstock.com/shutterstock/photos/2588014613/display_1500/stock-photo-cartoon-artistic-image-of-hulk-fist-smashing-through-a-black-brick-wall-with-lime-green-lightening-2588014613.jpg" alt="img">
        <a href="http://localhost:3000/posts/<%= post.id %>">See in details</a>
        <a href="http://localhost:3000/posts/<%= post.id %>/edit">Edit your post</a>
        <form method="post" action="/posts/<%= post.id %>?_method=DELETE"">
           <button>Delete</button>
        </form>
    <% }%>
    
    <a id="anchorTag" href="http://localhost:3000/posts/new">Create Post</a>
</body>
</html>